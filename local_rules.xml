<!-- Local rules -->
<!-- Home SOC Lite Lab — custom detections -->
<!-- Wazuh manager: /var/ossec/etc/rules/local_rules.xml -->

<group name="local,syslog,sshd,">

  <!--
    Detection: SSH brute force attempt
    MITRE ATT&CK: T1110.001 (Brute Force: Password Guessing)
    Fires when the base Wazuh SSH-authentication-failure rule (5760) matches
    4+ times from the same source IP within a 60-second window.

    Note: Wazuh's frequency attribute counts matches beyond the first
    occurrence, so frequency="3" = 4 total events, not 3.
  -->
  <rule id="100010" level="10" frequency="3" timeframe="60">
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip />
    <description>Custom: SSH brute force - 4+ failed logins from same source in 60 seconds</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failures,pci_dss_11.4,</group>
  </rule>

  <!--
    Detection: Successful login following a brute-force pattern (possible compromise)
    MITRE ATT&CK: T1110.001 (Brute Force: Password Guessing)
    Fires when a successful SSH login (base rule 5715) occurs from the same
    source IP that recently triggered rule 100010 above.

    Note: this depends on the failed attempts being logged BEFORE the
    successful one — event ordering matters for if_matched_sid to correlate.
  -->
  <rule id="100011" level="12">
    <if_sid>5715</if_sid>
    <if_matched_sid>100010</if_matched_sid>
    <same_source_ip />
    <description>Custom: Successful SSH login following brute force pattern - possible compromise</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_success,pci_dss_10.2.5,</group>
  </rule>

  <!--
    Detection: Firewall block event (base rule for port-scan correlation)
    Requires UFW to be enabled with logging on, and the ufw-block decoder
    (see local_decoder.xml) — or, as implemented here, a direct text match
    against the raw UFW log line, which proved more reliable than depending
    on a custom decoder's resolved name.
  -->
  <rule id="100012" level="5">
    <match>UFW BLOCK</match>
    <description>Firewall: UFW blocked a connection attempt</description>
    <group>firewall,</group>
  </rule>

  <!--
    Detection: Possible port scan
    MITRE ATT&CK: T1046 (Network Service Discovery)
    Escalates when 10+ UFW-blocked connection attempts occur from the same
    source IP within a 30-second window — the signature of an automated
    port scan (e.g., nmap -sS -p-).
  -->
  <rule id="100013" level="10" frequency="10" timeframe="30">
    <if_matched_sid>100012</if_matched_sid>
    <same_source_ip />
    <description>Custom: Possible port scan - 10+ blocked connections from same source in 30 seconds</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>recon,pci_dss_11.4,</group>
  </rule>

</group>
